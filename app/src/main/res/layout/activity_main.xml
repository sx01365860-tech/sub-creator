<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SubCreator - Trình Tạo Phụ Đề &amp; AI"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSelectFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Chọn File Video/Audio"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAiProcess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. AI Rà Soát Ngữ Cảnh"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnSaveSrt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Lưu / Chọn Thư Mục SRT"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái: Đang chờ chọn file..."
        android:textSize="14sp"/>

</LinearLayout>
